# Backend environment settings for SnoSentry
# Copy this file to .env and fill in your values

PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Reddit API credentials (required for live Reddit API access)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=SnoSentry/1.0
